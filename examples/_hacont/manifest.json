{
	"build": {
		"PARTITIONS_FILE": "./sdkconfig/partitions.csv"
	},
	"defines": {
		"XS_MODS": 1
	},
	"include": [
		"$(MODDABLE)/examples/manifest_base.json",
		"$(MODDABLE)/modules/network/wifi/manifest.json",
		"$(MODDABLE)/examples/manifest_net.json",
		"$(MODDABLE)/modules/network/ble/manifest_server.json",
		"$(MODDABLE)/examples/manifest_piu.json",
		"$(MODULES)/base/modules/manifest.json"
	],
	"modules": {
		"*": [
			"./main",
			"./keyboardService",
			"./hidkeyboard",
			"./hidmedia",
			"$(MODULES)/network/websocket/*",
			"$(MODULES)/data/base64/*",
			"$(MODULES)/data/logical/*",
			"$(MODULES)/crypt/digest/*",
			"$(MODULES)/crypt/digest/kcl/*"
		]
	},
	"strip": [],
	"ble":{
		"*": [
			"./bleservices/*"
		]
	},
	"resources": {
        "*-alpha": [
            "$(MODDABLE)/examples/assets/fonts/OpenSans-Regular-24"
        ]
    },
	"preload": [
		"main",
		"keyboardService",
		"hidkeyboard",
		"hidmedia",
		"websocket",
		"base64",
		"digest",
		"logical"
	],
	"platforms": {
		"lin": {
			"config": {
				"rotation": 0
			}
		},
		"esp32": {
			"config": {
				"ssid": "",
				"password": "",
				"rotation": 90,
				"startupSound": false
			}
		}
	}
}
